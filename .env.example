# 2GIS Catalog API key (https://docs.2gis.com/ru/api/search/places/overview)
DGIS_API_KEY=

# Telegram bot для отправки лидов (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Дефолтные настройки поиска
DEFAULT_CITY=Москва
DEFAULT_RUBRICS=кафе,ресторан,салон красоты,барбершоп,отель,хостел,магазин одежды,автосервис

# Лимиты
MAX_PLACES_PER_RUBRIC=200
REQUEST_TIMEOUT=20
CONCURRENCY=8

# Хранилище уже отправленных лидов (чтобы не дублировать)
SEEN_STORAGE=data/seen.json
LEADS_STORAGE=data/leads.jsonl
